{
  "info": {
    "_postman_id": "b18a6c8e-3d12-4299-8d75-4309e3a6c2f1",
    "name": "BookShelf Manager API",
    "description": "API collection for BookShelf Manager MERN Application covering all 4 endpoints: GET, POST, PUT, DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get All Books",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Retrieve all books ordered by creation date (newest first)."
      },
      "response": []
    },
    {
      "name": "Create a Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set('bookId', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt and David Thomas\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Creates a new book in the reading list with default status 'unread'."
      },
      "response": []
    },
    {
      "name": "Mark Book as Read",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Updates status of the specified book to 'read'."
      },
      "response": []
    },
    {
      "name": "Delete a Book",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Deletes the book with the specified id."
      },
      "response": []
    }
  ]
}

